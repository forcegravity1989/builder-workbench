# .bw/standard.toml —— 这个项目铺的是哪一版规范、这套包里有哪几类件。
# enabled = 二进制里真有模板的大类(第 0 站只落 charter + meta;
# docs-core / metrics / issue-policy 要走到那一站或配置屏「规范铺底」才落盘)。
# extensions 留给以后同事贡献的扩展件;空 = 还没有。
version    = "{{version}}"
enabled    = ["charter", "meta", "docs-core", "metrics", "issue-policy"]
extensions = []
source     = "builtin"
