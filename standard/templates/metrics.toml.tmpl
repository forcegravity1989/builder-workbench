schema_version = 2

# 指标定义与脚本协议见 system-prompt/references/metrics.md。
# 北极星可缺席；未明确用途与可用脚本前，不添加占位指标。
# [[feature]] 可选，name 对应指标的 feature，value 写该场景交付什么；顺序即记分牌页签顺序。
# [[lagging]] / [[leading]] 使用 name / def / target / collect。
# feature 空归“主要”，有值归对应特性；leads 关联明确滞后指标。
# collect 只支持 script + retro=true；run 为非空 argv。实际读数不可手填。
# 脚本按 day/week 查询真实历史 points，不支持仅当前 value 输出。
# week 的起止日期均为周一；未结束日/周的 points 必须带真实 coverage.start/end。
# 不登记每日采集，不创建 bw/ledger，不追加日采账本。
# 示例需按项目实际脚本填写后再启用：
# [[lagging]]
# name = "明确的结果指标"
# def = "实际采用的计算口径"
# target = "项目长期目标"
# collect = { kind = "script", run = ["实际解释器", ".bw/scripts/实际脚本"], retro = true }
