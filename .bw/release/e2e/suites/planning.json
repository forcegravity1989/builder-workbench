{
  "id": "version-planning",
  "feature": "version-planning",
  "title": "周一屏部署与浏览器文件共建",
  "layer": "browser",
  "profiles": ["pr", "pack"],
  "command": [
    "{node}",
    ".bw/release/e2e/planning.mjs",
    "--out",
    "{out}"
  ],
  "timeoutSeconds": 300,
  "expectedCases": [
    "planning-assets",
    "planning-autosave",
    "planning-model-readback",
    "planning-version-isolation",
    "planning-unknown-honesty",
    "planning-confirmation",
    "planning-conflict",
    "planning-bad-history"
  ]
}
