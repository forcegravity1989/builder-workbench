{
  "id": "bw-orca",
  "version": "0.5.0",
  "include": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "CONTEXT.md",
    "docs",
    "ref/upstream.md",
    ".claude/skills",
    "src/renderer/src/workbench"
  ],
  "exclude": ["docs/draft"],
  "entryPoints": [
    "^AGENTS\\.md$",
    "^CLAUDE\\.md$",
    "^README\\.md$",
    "^\\.claude/skills/[^/]+/SKILL\\.md$"
  ],
  "codeRoots": ["src/renderer/src/workbench", "standard"],
  "codeAreaDepth": 5,
  "largeDocChars": 12000,
  "duplicateParagraphChars": 80,
  "tradeoff": {
    "paths": [
      "^docs/06-module/(?!README\\.md$).+\\.md$",
      "^docs/02-adr/.+\\.md$",
      "^docs/architecture\\.md$"
    ],
    "pattern": "取舍|权衡|为什么|为何|放弃|代价|备选|不选|否决|而不是|Considered Options|trade-?off"
  },
  "drift": [
    { "label": "计数", "pattern": "(?<![≥≤<>\\w.#+-])\\d+\\s?(?:条|个|项|篇|处|件|组|份|轮|张)" },
    { "label": "PR/Issue 号", "pattern": "(?<![\\w&/])#\\d{2,5}\\b" },
    { "label": "日期", "pattern": "\\b20\\d{2}-\\d{2}-\\d{2}\\b" },
    { "label": "文件行号", "pattern": "\\.(?:rs|mjs|js|ts|tsx|py|ps1|sh|toml|json|md):\\d+\\b" }
  ]
}
