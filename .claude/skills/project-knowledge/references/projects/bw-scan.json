{
  "id": "bw-knowledge-pilot",
  "version": "0.3.0-pilot",
  "status": "仓内试用映射；不作为全仓规范门禁",
  "scopeNote": "按目标仓实际存在的文件生成全景。include 是候选路径，缺失路径列为跳过，不要求恢复已删除文档。项目知识与开发方法单列；standard 本次不扫描。",
  "suggestedSessions": [
    "读回已合入规则，用真实维护任务检验入口和职责。",
    "特性总表：核对候选、实际文档和架构映射。",
    "一个完整特性：指标、验收、用例与证据；复用正在进行的任务。"
  ],
  "contractSource": "../document-contracts.md",
  "include": [
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "CONTEXT.md",
    "DESIGN.md",
    "CHANGELOG.md",
    "docs",
    ".bw/project.toml",
    ".bw/metrics.toml",
    ".claude/skills"
  ],
  "exclude": [
    "docs/draft"
  ],
  "extensions": [
    ".md",
    ".html",
    ".toml"
  ],
  "longParagraphChars": 300,
  "duplicateParagraphChars": 80,
  "featureDirectory": "docs/05-features",
  "acceptanceTableHeaders": [
    "验收点",
    "场景/用例入口",
    "运行证据"
  ],
  "rules": [
    {
      "pattern": "^AGENTS\\.md$",
      "type": "开发规则",
      "fields": [
        {
          "label": "构建与验证入口",
          "pattern": "构建|怎么建|验证|测试"
        },
        {
          "label": "提交与交付边界",
          "pattern": "提交|commit|PR|合入"
        }
      ]
    },
    {
      "pattern": "^CLAUDE\\.md$",
      "type": "规则导入"
    },
    {
      "pattern": "^CONTEXT\\.md$",
      "type": "领域词表"
    },
    {
      "pattern": "^DESIGN\\.md$",
      "type": "设计入口"
    },
    {
      "pattern": "^CHANGELOG\\.md$",
      "type": "变更记录"
    },
    {
      "pattern": "^README\\.md$|/README\\.md$",
      "type": "入口与地图"
    },
    {
      "pattern": "^docs/01-principles/",
      "type": "产品与组织原则"
    },
    {
      "pattern": "^docs/(02-adr|adr)/",
      "type": "架构决策",
      "fields": [
        {
          "label": "背景",
          "pattern": "背景|问题|context"
        },
        {
          "label": "决定与取舍",
          "pattern": "决定|决策|取舍|decision"
        }
      ]
    },
    {
      "pattern": "^docs/05-features/.*/intent\\.md$",
      "type": "特性意图",
      "fields": [
        {
          "label": "用户与问题",
          "pattern": "用户|构建者|使用者"
        },
        {
          "label": "预期结果",
          "pattern": "结果|价值|成功|收益"
        }
      ]
    },
    {
      "pattern": "^docs/05-features/.*/spec\\.md$",
      "type": "特性规格",
      "fields": [
        {
          "label": "边界",
          "pattern": "边界|范围|不做|非目标"
        },
        {
          "label": "验收",
          "pattern": "验收|判据|acceptance"
        }
      ]
    },
    {
      "pattern": "^docs/05-features/",
      "type": "特性变更材料"
    },
    {
      "pattern": "^docs/architecture\\.md$",
      "type": "整体架构"
    },
    {
      "pattern": "^docs/06-module/",
      "type": "模块实现心智"
    },
    {
      "pattern": "^docs/03-guide/",
      "type": "用户指南"
    },
    {
      "pattern": "^docs/(04-design-system|hifi)/",
      "type": "视觉与交互"
    },
    {
      "pattern": "^docs/metrics\\.md$",
      "type": "历史指标快照"
    },
    {
      "pattern": "^docs/10-reference/",
      "type": "参考与历史"
    },
    {
      "pattern": "^\\.bw/",
      "type": "项目运行定义"
    },
    {
      "pattern": "^\\.claude/skills/.*/SKILL\\.md$",
      "type": "开发方法入口"
    },
    {
      "pattern": "^\\.claude/skills/",
      "type": "开发方法支撑"
    }
  ],
  "limits": [
    "standard 是对外分发层，本次不扫描。",
    "源码、测试脚本、CSS 等不在此文档清单；相关读取方须另行检查。",
    "HTML/TOML 只列资产，不解析正文；字段匹配只提示候选，不验证语义。",
    "现有特性目录是文档组，不是已经核定的产品特性全集。"
  ]
}
