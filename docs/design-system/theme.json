{
  "name": "Builder",
  "references": ["Orca", "Multica", "Linear-class tool UI"],
  "defaultTheme": "apple",
  "modes": ["light"],
  "themes": {
    "apple": {
      "bg": "#ffffff",
      "surface": "#f5f5f7",
      "card": "#ffffff",
      "text": "#1d1d1f",
      "accent": "#0071e3",
      "accent2": "#5856d6",
      "success": "#34c759",
      "warning": "#ff9500",
      "danger": "#ff3b30"
    },
    "claude": {
      "bg": "#faf9f5",
      "surface": "#f0eee6",
      "card": "#fefdfa",
      "text": "#1f1e1d",
      "accent": "#d97757",
      "accent2": "#4c73a5",
      "success": "#579766",
      "warning": "#ce9042",
      "danger": "#c15f4d"
    }
  },
  "fonts": {
    "heading": { "family": "system stack (SF Pro / Segoe UI; han via per-script system default: PingFang SC / Microsoft YaHei)", "class": "neo-grotesque", "weights": [600] },
    "body": { "family": "system stack; han via per-script platform default (PingFang SC / Microsoft YaHei / Noto Sans CJK SC)", "class": "neo-grotesque", "weights": [400, 500, 600] },
    "mono": { "family": "system mono stack (SF Mono / Menlo / Consolas); han falls to system CJK", "weights": [400] }
  },
  "langs": ["en", "zh"],
  "density": 0.85,
  "radius": { "sm": 6, "md": 8, "lg": 12 },
  "layoutStyle": "app",
  "frame": "hairline",
  "imageTreatment": "crisp",
  "iconSet": "lucide",
  "iconStroke": 2
}
