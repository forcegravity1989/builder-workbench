# Copy to .env (or /etc/bw-share.env for systemd) and adjust.

# Listen address and port.
BW_SHARE_HOST=0.0.0.0
BW_SHARE_PORT=8787

# Where share files are written. Must be writable by the service user.
# Relative paths resolve from the working directory; under the systemd unit the
# default is /var/lib/bw-share (StateDirectory), so leave this unset there.
BW_SHARE_DATA_DIR=./data

# Key that Workbench clients present once to mint a per-device upload token.
# Leave empty to use the value compiled into the Workbench client.
BW_SHARE_ENROLL_KEY=

# Optional extra upload token for scripts or manual ops via x-upload-token.
# Device enrollment tokens work independently of this value.
BW_SHARE_UPLOAD_TOKEN=

# Absolute URL users will open. Set this when a proxy or domain sits in front.
BW_SHARE_PUBLIC_BASE_URL=

# Per-share size cap in bytes (default 200 MiB).
BW_SHARE_MAX_BYTES=209715200

# Days before a share expires. 0 keeps shares forever.
BW_SHARE_RETENTION_DAYS=30

# Write requests allowed per client per minute. 0 disables the limit.
BW_SHARE_RATE_LIMIT=30

# Only enable behind a trusted proxy: takes client IP and scheme from
# X-Forwarded-For / X-Forwarded-Proto.
BW_SHARE_TRUST_PROXY=false
